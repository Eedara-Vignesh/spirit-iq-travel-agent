# SpiritIQ Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!

# ============================================================================
# Core AI & Maps Intelligence
# ============================================================================
# Groq API Key (AI Travel Planning Orchestration)
GROQ_API_KEY=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

# Groq Model Name (Configurable: llama-3.3-70b-versatile recommended)
GROQ_MODEL=llama-3.3-70b-versatile

# Google Maps Platform API Key (Optional Places & Routes override)
# NOTE: SpiritIQ operates 100% FREE without Google Maps!
# By default, OpenStreetMap (Photon autocomplete) and OSRM (road routing) are active with no key and no billing account.
# If you wish to optionally enable Google Maps Platform, provide your key below:
GOOGLE_MAPS_API_KEY=

# Open-Meteo Weather API
# Free open-access satellite reanalysis endpoint (no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ============================================================================
# External Booking Providers (Commercial & Partner APIs)
# ============================================================================
# NOTE: Official GDS/OTA booking integrations require enterprise commercial agreements.
# SpiritIQ provides verified direct booking handoffs when live API keys are absent.

# Indian Railways (CRIS / IRCTC Integration)
# Access: Requires IRCTC Enterprise B2B Partnership / Partner Auth Token
IRCTC_PARTNER_API_KEY=

# Airline Ticketing (IndiGo Partner API / Amadeus GDS)
# Access: Amadeus Developer Portal or Airline GDS Corporate Agreement
AIRLINE_GDS_API_KEY=
AIRLINE_GDS_API_SECRET=

# Hotel Accommodations (Booking.com Partner Network / MakeMyTrip)
# Access: Booking.com Affiliate Partner ID or Rapid Travel API
BOOKING_COM_AFFILIATE_ID=
BOOKING_COM_API_KEY=

# Intercity Bus Booking (RedBus B2B Partner Network)
# Access: RedBus Enterprise Partner API
REDBUS_PARTNER_API_KEY=

# Payment Gateway (Razorpay / Cashfree)
# Access: Test or live Merchant ID & Secret Key (Never executed without explicit user gate)
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=

